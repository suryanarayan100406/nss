#!/usr/bin/env bash
#
# nss-decommission — remove the inauguration system, leave the website.
#
# Runs as root (see /etc/sudoers.d/nss-inauguration, which grants the service one
# command and nothing else). Installed 0750 root:root, so the service account can
# execute it but cannot read or modify it.
#
# THREE PROPERTIES THIS SCRIPT IS BUILT AROUND
#
# 1. It takes NO ARGUMENTS. Passing it anything is an error, not a hint. Every path
#    below is a literal in this file. There is no glob, no prefix match, no `find`,
#    no variable path, and nothing read from the environment — so a request that
#    reached the backend can never name a file to delete or a command to run.
#
# 2. Nothing is removed until the permanent configuration has been written, tested,
#    reloaded and verified over HTTP — and the backend, which is the only thing that
#    can re-render routing, is removed LAST of all. Every phase that fails leaves the
#    system in one of two recoverable states: exactly as it was, or already serving
#    the permanent site with the backend still running to fix anything.
#
# 3. It never deletes its own mechanism while it is still running. Removing the
#    script, the sudoers rule and the unit is the job of a detached helper that
#    waits for this process to exit first.
#
# Idempotent: run it again after success and it is a clean no-op that changes
# nothing. Backups and logs live outside the installation directory and are never
# deleted by any phase — a failed cleanup is exactly when the snapshot is needed.
#
set -euo pipefail

readonly PROGRAM=${0##*/}

# ---------------------------------------------------------------------------
# Layout — every one of these is a literal.
# ---------------------------------------------------------------------------
readonly INSTALL_DIR=/opt/nss-inauguration
readonly CONFIG_DIR=/opt/nss-inauguration/config
readonly SITE_JSON=/opt/nss-inauguration/config/site.json
readonly VENV_DIR=/opt/nss-inauguration/venv

readonly WEB_ROOT=/var/www/nss
readonly BACKUP_ROOT=/var/backups/nss-inauguration
readonly LOG_DIR=/var/log/nss-inauguration
readonly CLEANUP_LOG=/var/log/nss-inauguration/cleanup.log

readonly NGINX_INC=/etc/nginx/nss-mode.inc
readonly NGINX_SITE=/etc/nginx/sites-available/nss
readonly NGINX_BIN=/usr/sbin/nginx

readonly SERVICE=nss-inauguration
readonly UNIT=/etc/systemd/system/nss-inauguration.service
readonly SUDOERS=/etc/sudoers.d/nss-inauguration
readonly SELF=/usr/local/sbin/nss-decommission

readonly SITE_HOST=nss.iiitnr.ac.in
readonly CHECK_BASE=http://127.0.0.1

# ---------------------------------------------------------------------------
# The allowlist. These are the only paths in the web root this script will ever
# remove, and they are written out by hand. A path that is not on this list
# cannot be deleted, however the script is invoked.
# ---------------------------------------------------------------------------
readonly TEMP_FILES=(
  /var/www/nss/inauguration.html
  /var/www/nss/coming-soon.html
)
readonly TEMP_DIRS=(
  /var/www/nss/admin
)

# Everything the permanent site is made of. Phase 0 refuses to start if any of
# these is missing, and no phase may ever remove one.
readonly PERMANENT_FILES=(
  /var/www/nss/index.html
  /var/www/nss/team.html
  /var/www/nss/nss_logo.jpg
  /var/www/nss/css/style.css
  /var/www/nss/js/main.js
)
readonly PERMANENT_DIRS=(
  /var/www/nss/css
  /var/www/nss/js
  /var/www/nss/vendor
  /var/www/nss/assets
)

# ---------------------------------------------------------------------------
# The permanent routing. This is render_include("permanent") from
# app/nginx_mode.py, reproduced verbatim; tests/test_decommission.py asserts the
# two are byte-identical, so they cannot drift apart without the suite failing.
# ---------------------------------------------------------------------------
readonly PERMANENT_INCLUDE='# Generated by nss-inauguration. Do not edit by hand — it is rewritten on every mode change.
    location / {
        try_files $uri $uri/ =404;
    }'

CURRENT_PHASE="startup"
BACKUP_DIR=""

# ---------------------------------------------------------------------------
# Reporting
# ---------------------------------------------------------------------------

log() {
  printf '%s  %s\n' "$(date -Is)" "$*"
}

# Everything is both printed and appended to the log the institute keeps. The log
# directory is outside the installation and survives every phase.
record() {
  mkdir -p "$LOG_DIR"
  printf '%s  phase=%s  %s\n' "$(date -Is)" "$CURRENT_PHASE" "$*" >> "$CLEANUP_LOG"
}

phase() {
  CURRENT_PHASE=$1
  log ""
  log "── $1 — $2"
  record "begin: $2"
}

die() {
  log "FAILED ($CURRENT_PHASE): $*"
  record "FAILED: $*"
  exit 1
}

ok() {
  log "  ok: $*"
  record "ok: $*"
}

# ---------------------------------------------------------------------------
# Preconditions
# ---------------------------------------------------------------------------

read_state_field() {
  # Reads one key out of site.json with the interpreter the app already needs.
  # No key is ever interpolated from outside this file.
  "$VENV_DIR/bin/python" - "$SITE_JSON" "$1" <<'PY'
import json, sys
with open(sys.argv[1], encoding="utf-8") as fh:
    print(json.load(fh).get(sys.argv[2], ""))
PY
}

require_root() {
  [ "$(id -u)" -eq 0 ] || die "must run as root"
}

require_no_arguments() {
  if [ "$#" -ne 0 ]; then
    die "this script takes no arguments (got $#); nothing was changed"
  fi
}

# ---------------------------------------------------------------------------
# HTTP verification
#
# The site is only considered good when it answers over HTTP, not when a file
# looks right on disk. Nginx serves the permanent site with no application behind
# it, so this is exactly the check the audience would perform.
# ---------------------------------------------------------------------------

http_status() {
  curl -s -o /dev/null -w '%{http_code}' --max-time 15 -H "Host: $SITE_HOST" "$CHECK_BASE$1" 2>/dev/null || echo 000
}

# Is the homepage the *permanent* homepage, and not a hold page or the ceremony?
#
# The strongest form is a byte comparison against index.html, which is what the
# audience's browser receives for a static file. A proxy that re-encodes the body
# would defeat that, so there is a fallback: the page's own <title>, which is a
# single line and survives re-encoding.
serves_the_permanent_homepage() {
  local tmp
  tmp=$(mktemp)
  curl -s --max-time 15 -H "Host: $SITE_HOST" "$CHECK_BASE/" -o "$tmp" 2>/dev/null || true

  if cmp -s "$tmp" "$WEB_ROOT/index.html"; then
    rm -f "$tmp"
    return 0
  fi

  local title
  title=$(sed -n 's:.*<title>\(.*\)</title>.*:\1:p' "$WEB_ROOT/index.html" | head -1)
  local found=1
  if [ -n "$title" ] && grep -qF -- "$title" "$tmp"; then
    found=0
  fi
  rm -f "$tmp"
  return "$found"
}

verify_permanent_site() {
  # Returns 0 only if the permanent website is genuinely serving on its own.
  local status

  status=$(http_status /)
  case "$status" in
    200) ok "/ returns 200" ;;
    *)   log "  / returned $status"; return 1 ;;
  esac

  # The homepage the audience gets must be the permanent one, not a hold page and
  # not the ceremony.
  if ! serves_the_permanent_homepage; then
    log "  / is not serving index.html"
    return 1
  fi
  ok "/ is serving index.html"

  local asset
  for asset in /nss_logo.jpg /css/style.css /js/main.js; do
    status=$(http_status "$asset")
    if [ "$status" != "200" ]; then
      log "  asset $asset returned $status"
      return 1
    fi
  done
  ok "permanent assets return 200"

  # The portal must be gone once routing is permanent. A 404 is the success case;
  # a 200 here would mean the backend is still being proxied.
  status=$(http_status /admin/)
  if [ "$status" = "200" ]; then
    log "  /admin/ still returns 200 after the move to permanent routing"
    return 1
  fi
  ok "/admin/ no longer serves (HTTP $status)"

  return 0
}

# ---------------------------------------------------------------------------
# Nginx
# ---------------------------------------------------------------------------

nginx_test() {
  "$NGINX_BIN" -t 2>&1 | sed 's/^/    /'
}

write_include() {
  # Writes the permanent include atomically, so a reader never sees half a file.
  local content=$1 target=$2 tmp
  tmp=$(mktemp "${target}.XXXXXX")
  printf '%s\n' "$content" > "$tmp"
  chmod 0644 "$tmp"
  mv -f "$tmp" "$target"
}

reload_nginx() {
  if ! "$NGINX_BIN" -s reload 2>&1 | sed 's/^/    /'; then
    return 1
  fi
  # The reload returns as soon as the master signals; give the workers a moment to
  # pick up the new configuration before asking the site what it is serving.
  sleep 1
}

# ---------------------------------------------------------------------------
# Phase 0 — preconditions (read-only; changes nothing)
# ---------------------------------------------------------------------------

phase_0_preconditions() {
  phase "phase 0" "preconditions (read-only)"

  require_root

  command -v curl >/dev/null 2>&1 \
    || die "curl is required to verify the site over HTTP and was not found"

  # -- idempotency ---------------------------------------------------------
  # A completed run leaves no installation and no temporary files. Coming back to
  # that state is success, not an error: the cleanup must be safe to re-run.
  local leftovers=0 f
  [ -e "$INSTALL_DIR" ] && leftovers=1
  for f in "${TEMP_FILES[@]}"; do [ -e "$f" ] && leftovers=1; done
  for f in "${TEMP_DIRS[@]}"; do [ -e "$f" ] && leftovers=1; done

  if [ "$leftovers" -eq 0 ]; then
    log "  nothing left to remove — the inauguration system is already gone"
    record "no-op: already decommissioned"
    log ""
    log "✓ Nothing to do. The permanent site is untouched by this run."
    exit 0
  fi

  # -- the inauguration really happened ------------------------------------
  [ -f "$SITE_JSON" ] || die "$SITE_JSON is missing; refusing to run"
  [ -x "$VENV_DIR/bin/python" ] || die "$VENV_DIR/bin/python is missing; refusing to run"

  local completed
  completed=$(read_state_field inauguration_completed)
  [ "$completed" = "True" ] \
    || die "the inauguration is not marked complete; the cleanup stays locked"

  # -- the permanent site is intact before we start touching anything -------
  for f in "${PERMANENT_FILES[@]}"; do
    [ -s "$f" ] || die "permanent file missing or empty: $f"
  done
  for d in "${PERMANENT_DIRS[@]}"; do
    [ -d "$d" ] || die "permanent directory missing: $d"
  done
  [ -f "$NGINX_SITE" ] || die "$NGINX_SITE is missing; refusing to run"
  [ -f "$NGINX_INC" ] || die "$NGINX_INC is missing; refusing to run"

  ok "the inauguration is recorded as complete"
  ok "every permanent file and directory is present"

  # -- who owns the web root ------------------------------------------------
  # A sanity check that we are looking at a deployment and not, say, a checkout.
  if [ ! -d "$BACKUP_ROOT" ]; then
    log "  note: $BACKUP_ROOT does not exist yet; it will be created in phase 1"
  fi

  record "preconditions passed"
}

# ---------------------------------------------------------------------------
# Phase 1 — the restore point, written before anything is touched
# ---------------------------------------------------------------------------

phase_1_backup() {
  phase "phase 1" "backup"

  local stamp
  stamp=$(date +%Y%m%d-%H%M%S)
  BACKUP_DIR="$BACKUP_ROOT/cleanup-$stamp"

  mkdir -p "$BACKUP_DIR"
  chmod 0700 "$BACKUP_DIR"

  # The configuration, the state, and both nginx files: everything needed to put
  # the inauguration system back exactly as it was.
  mkdir -p "$BACKUP_DIR/config"
  cp -a "$CONFIG_DIR/." "$BACKUP_DIR/config/" 2>/dev/null || true
  cp -a "$NGINX_INC" "$BACKUP_DIR/nss-mode.inc"
  cp -a "$NGINX_SITE" "$BACKUP_DIR/nss-site"
  [ -f "$UNIT" ] && cp -a "$UNIT" "$BACKUP_DIR/nss-inauguration.service"
  [ -f "$SUDOERS" ] && cp -a "$SUDOERS" "$BACKUP_DIR/nss-inauguration.sudoers"

  # The web root's temporary files too, so a rollback can restore the ceremony
  # page the public were looking at.
  mkdir -p "$BACKUP_DIR/web"
  local f
  for f in "${TEMP_FILES[@]}"; do
    [ -f "$f" ] && cp -a "$f" "$BACKUP_DIR/web/"
  done
  for f in "${TEMP_DIRS[@]}"; do
    [ -d "$f" ] && cp -a "$f" "$BACKUP_DIR/web/"
  done

  # Checksums, so the snapshot can be proven intact later.
  ( cd "$BACKUP_DIR" && find . -type f ! -name MANIFEST.sha256 -print0 \
      | sort -z | xargs -0 sha256sum > MANIFEST.sha256 )

  ( cd "$BACKUP_DIR" && sha256sum --check --quiet MANIFEST.sha256 ) \
    || die "the backup at $BACKUP_DIR did not verify; nothing has been removed"

  ok "snapshot written and verified: $BACKUP_DIR"
  record "backup=$BACKUP_DIR"
}

# ---------------------------------------------------------------------------
# Phase 2 — routing, with the backend still running
# ---------------------------------------------------------------------------

phase_2_routing() {
  phase "phase 2" "permanent routing (backend still running)"

  local previous
  previous=$(cat "$NGINX_INC")

  if [ "$previous" = "$PERMANENT_INCLUDE" ]; then
    ok "routing is already permanent"
  else
    # Written, then tested, then reloaded — and only in that order. nginx -t reads
    # the file from disk but does not act on it until the reload, so a rejected
    # candidate can be put back with nothing having changed.
    write_include "$PERMANENT_INCLUDE" "$NGINX_INC"
    ok "candidate routing written to $NGINX_INC"

    if ! nginx_test; then
      write_include "$previous" "$NGINX_INC"
      die "nginx -t rejected the permanent routing; the previous routing is restored"
    fi
    ok "nginx -t accepted the permanent routing"

    if ! reload_nginx; then
      write_include "$previous" "$NGINX_INC"
      "$NGINX_BIN" -t >/dev/null 2>&1 && "$NGINX_BIN" -s reload >/dev/null 2>&1 || true
      die "nginx reload failed; the previous routing is restored"
    fi
    ok "nginx reloaded"
  fi

  # The decisive check: the site answers over HTTP as the permanent site, from
  # nginx alone. The backend is still up and untouched at this point, so if this
  # fails the previous routing goes back and the system manages itself again.
  if ! verify_permanent_site; then
    if [ "$previous" != "$PERMANENT_INCLUDE" ]; then
      log "  restoring the previous routing"
      write_include "$previous" "$NGINX_INC"
      "$NGINX_BIN" -t >/dev/null 2>&1 && "$NGINX_BIN" -s reload >/dev/null 2>&1 || true
      record "phase 2 failed; previous routing restored"
      die "the permanent site did not verify over HTTP; the previous routing is restored"
    fi
    record "phase 2 failed; routing was already permanent"
    die "the permanent site did not verify over HTTP"
  fi

  ok "the permanent site serves on its own, over HTTP"
  record "routing is permanent and verified"
}

# ---------------------------------------------------------------------------
# Phase 3 — the temporary web files
# ---------------------------------------------------------------------------

phase_3_web_files() {
  phase "phase 3" "temporary web files"

  # Only the literal paths in the allowlist. Nothing wildcarded, nothing derived.
  local f
  for f in "${TEMP_FILES[@]}"; do
    if [ -e "$f" ]; then
      rm -f -- "$f"
      ok "removed $f"
      record "removed=$f"
    fi
  done
  for f in "${TEMP_DIRS[@]}"; do
    if [ -e "$f" ]; then
      rm -rf -- "$f"
      ok "removed $f"
      record "removed=$f"
    fi
  done

  # Belt and braces: whatever happened above, no permanent file may be gone.
  for f in "${PERMANENT_FILES[@]}"; do
    [ -s "$f" ] || die "a permanent file disappeared: $f"
  done

  if ! verify_permanent_site; then
    die "the permanent site stopped serving after the temporary files were removed"
  fi
  ok "the permanent site still serves"
  record "temporary web files removed; site verified"
}

# ---------------------------------------------------------------------------
# Phase 4 — the backend, last
# ---------------------------------------------------------------------------

phase_4_backend() {
  phase "phase 4" "the backend (last)"

  # Everything before this point can be undone with the backend still alive. This
  # is the only phase that removes the ability to re-render routing, which is why
  # it comes after the site has been proven good over HTTP.
  if systemctl list-unit-files "$SERVICE.service" >/dev/null 2>&1; then
    systemctl stop "$SERVICE" 2>/dev/null || true
    systemctl disable "$SERVICE" 2>/dev/null || true
    ok "service stopped and disabled"
    record "service stopped and disabled"
  fi

  if [ -d "$INSTALL_DIR" ]; then
    rm -rf -- "$INSTALL_DIR"
    ok "removed $INSTALL_DIR"
    record "removed=$INSTALL_DIR"
  fi

  # The site does not depend on the backend in any way — this is what proves it.
  if ! verify_permanent_site; then
    die "the permanent site stopped serving after the backend was removed"
  fi
  ok "the permanent site still serves with no backend at all"
  record "backend removed; site verified"
}

# ---------------------------------------------------------------------------
# Phase 5 — the record
# ---------------------------------------------------------------------------

phase_5_record() {
  phase "phase 5" "record"

  record "cleanup completed successfully"
  log ""
  log "  The inauguration system has been removed."
  log "    permanent site   $WEB_ROOT (index.html and every asset, untouched)"
  log "    snapshot         $BACKUP_DIR"
  log "    log              $CLEANUP_LOG"
  log ""
  log "  Still to be removed by the helper:"
  log "    $UNIT"
  log "    $SUDOERS"
  log "    $SELF"
}

# ---------------------------------------------------------------------------
# Phase 6 — self-removal, from outside this process
#
# The script cannot delete itself while it is still executing. So it hands the job
# to a small detached helper that waits for this PID to exit and only then removes
# the unit, the sudoers rule and the script.
# ---------------------------------------------------------------------------

phase_6_self_removal() {
  phase "phase 6" "self-removal"

  local helper
  helper=$(mktemp /tmp/nss-decommission-finish.XXXXXX)
  chmod 0700 "$helper"

  local pid=$$
  cat > "$helper" <<HELPER
#!/bin/bash
# Removes the cleanup mechanism once the script that spawned it has exited.
set -u
for _ in \$(seq 1 120); do
  kill -0 $pid 2>/dev/null || break
  sleep 1
done
sleep 1
rm -f -- $UNIT
rm -f -- $SUDOERS
rm -f -- $SELF
systemctl daemon-reload 2>/dev/null || true
rm -f -- \$0
HELPER

  # setsid detaches it from this session so it survives the exit it is waiting for.
  if command -v setsid >/dev/null 2>&1; then
    setsid "$helper" >/dev/null 2>&1 &
  else
    nohup "$helper" >/dev/null 2>&1 &
  fi

  ok "the removal helper is waiting for this process to exit"
  record "self-removal scheduled (helper=$helper)"
}

# ---------------------------------------------------------------------------
# Failure handling
# ---------------------------------------------------------------------------

on_error() {
  local line=$1
  record "aborted at line $line during $CURRENT_PHASE"
  log ""
  log "✗ The cleanup stopped during $CURRENT_PHASE (line $line)."
  log "  Nothing further was removed. The system is in one of two states:"
  log "    · unchanged, or"
  log "    · already serving the permanent site with the backend still running."
  log "  Snapshot: ${BACKUP_DIR:-none taken}"
  log "  Log:      $CLEANUP_LOG"
  log "  Re-run this script to resume; it re-checks every phase and is idempotent."
  exit 1
}

trap 'on_error $LINENO' ERR

# ---------------------------------------------------------------------------

main() {
  require_no_arguments "$@"

  log ""
  log "NSS inauguration — cleanup"
  log "========================="

  phase_0_preconditions
  phase_1_backup
  phase_2_routing
  phase_3_web_files
  phase_4_backend
  phase_5_record
  phase_6_self_removal

  log ""
  log "✓ Done. The website is permanent and has no inauguration system behind it."
  exit 0
}

main "$@"
